{
  "name": "althunter",
  "version": "2.0.0",
  "private": true,
  "description": "Relative Strength Decoupling Hunter — Institutional-grade RS detection with backtest",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "tsx eval/run.ts",
    "eval:generate": "tsx eval/run.ts --generate",
    "eval:judge": "tsx eval/run.ts --generate --judge=llm",
    "eval:agent": "tsx eval/agent/run.ts",
    "eval:all": "npm run eval && npm run eval:agent"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "lightweight-charts": "^4.2.1",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "tsx": "^4.23.15",
    "typescript": "5.7.2",
    "vitest": "^5.1.1"
  }
}
