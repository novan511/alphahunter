# Copy this file to .env.local and fill in your values
# Public market data (works in more regions than api.binance.com)
BINANCE_BASE_URL=https://data-api.binance.vision
# DEFAULT_INDEX=BTCUSDT
# DEFAULT_ASSET=ETHUSDT

# Supabase (for last-scan persistence)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Telegram (for early-warning push — server-only, never NEXT_PUBLIC_)
# 1. Chat @BotFather on Telegram → /newbot → copy the token
# 2. Chat your bot once (or add it to a group), then get the chat id:
#    https://api.telegram.org/bot<TOKEN>/getUpdates  (look for "chat":{"id":...})
#    ...or message @userinfobot for your personal id
# 3. Fill both below and restart the dev server
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Cron auth (server-only). Shared by /api/scan-cron and /api/futures-cron:
# GitHub Actions sends it as "Authorization: Bearer <secret>". Generate with
# `openssl rand -hex 32`, put the same value in .env.local AND in the
# SCAN_CRON_SECRET GitHub/Vercel secret. Without it both cron routes 401.
# SCAN_CRON_SECRET=
#
# ============================================================
# LLM / AI — dipisah per fungsi
# ============================================================

# AntSeed gateway (gratis) → ANALISIS FUTURES (S&R, pattern HTF, arah sinyal)
#   di /api/futures-ai dan lib/quant/futuresAI.ts
#   LLM_BASE_URL=https://8379-...um.instabox.tech/v1/chat/completions
#   LLM_API_KEY=antseed_...          (isi di .env.local, JANGAN di-commit)
#   LLM_MODEL=glm-4.7-flash          (pilih model gratis dari daftar gateway)
#   LLM_MAX_TOKENS=1500
#
# Jika kosong, /api/futures-ai otomatis pakai rule-based fallback tanpa model.

# DeepSeek (berbayar) → MONITORING QUANT (backtest risk review, supervisor)
#   di /api/quant-monitor dan /api/quant-supervisor
#   DEEPSEEK_API_KEY=sk-...isi_di_sini...
#   DEEPSEEK_BASE_URL=https://api.deepseek.com/v1/chat/completions
#   DEEPSEEK_MODEL=deepseek-chat
#
# Jika DEEPSEEK_API_KEY tidak diset, monitoring otomatis pakai NVIDIA_API_KEY
# (jika ada), lalu rule-based fallback. Kedua klien tidak dicampur.

# Futures Telegram cron also needs:
# 1. Supabase tables: run supabase/migrations/010_futures_alert_state.sql once
#    in the SQL Editor (dedupe cursor — without it every tick is a baseline).
# 2. The workflow .github/workflows/futures-cron.yml (every :03/:33) plus the
#    VERCEL_URL secret pointing at the deployment.
